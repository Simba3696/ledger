# Copy this file to client/.env (gitignored, checkout-local) and uncomment
# whichever settings you need — an unset value keeps the default behavior.
# Only relevant when running a second checkout alongside this one; see
# server/.env.example and README's "Running a second checkout alongside an
# existing one" section.

# Must match server/.env's PORT above — otherwise this checkout's dev server
# still starts fine, but its /api proxy points at the wrong server.
# VITE_DEV_PORT=5273
# VITE_API_PROXY_TARGET=http://localhost:4100

# Supabase Auth (docs/architecture/LLD.md §6, §9): the project URL and its
# public anon key, both safe to ship in the bundle. Required: the app can't
# sign in without them. Local stack: `npx supabase status` prints both
# (URL http://127.0.0.1:54321); a hosted project shows them under
# Project Settings > API.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>
