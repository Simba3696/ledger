        "statusField": "404"
      },
      {
        "method": "GET",
        "path": "/repos/{o}/{r}/contents/ledger?ref=main",
        "status": 404,
        "message": "This repository is empty.",
        "documentation_url": "https://docs.github.com/v3/repos/contents/#get-contents",
        "statusField": "404"
      },
      {
        "method": "GET",
        "path": "/repos/{o}/{r}/git/ref/heads/main",
        "status": 409,
        "message": "Git Repository is empty.",
        "documentation_url": "https://docs.github.com/rest/git/refs#get-a-reference",
        "statusField": "409"
      },
      {
        "method": "GET",
        "path": "/repos/{o}/{r}/git/refs/heads",
        "status": 409,
        "message": "Git Repository is empty.",
        "documentation_url": "https://docs.github.com/rest/git/refs#get-all-references-in-a-namespace",
        "statusField": "409"
      },
      {
        "method": "GET",
        "path": "/repos/{o}/{r}/git/trees/main?recursive=1",
        "status": 409,
        "message": "Git Repository is empty.",
        "documentation_url": "https://docs.github.com/rest/git/trees#get-a-tree",
        "statusField": "409"
      },
      {
        "method": "GET",
        "path": "/repos/{o}/{r}/git/blobs/0000000000000000000000000000000000000000",
        "status": 409,
        "message": "Git Repository is empty.",
        "documentation_url": "https://docs.github.com/rest/git/blobs#get-a-blob",
        "statusField": "409"
      }
    ],
    "firstPut": {
      "status": 201,
      "nestedPathCreated": true,
      "commitParents": [],
      "contentShaIsGitBlobSha": true
    }
  },
  "put": {
    "$comment": "PUT /repos/{o}/{r}/contents/{path} with {message, content (base64), sha?}.",
    "responseKeys": {
      "top": [
        "content",
        "commit"
      ],
      "content": [
        "name",
        "path",
        "sha",
        "size",
        "url",
        "html_url",
        "git_url",
        "download_url",
        "type",
        "_links"
      ],
      "commit": [
        "sha",
        "node_id",
        "url",
        "html_url",
        "author",
        "committer",
        "tree",
        "message",
        "parents",
        "verification"
      ]
    },
    "commitParentsShape": "array of {sha, url, html_url}; [] for the repo's first commit",
    "contentShaIsGitBlobSha": true,
    "cases": [
      {
        "name": "create, no sha, path absent",
        "status": 201
      },
      {
        "name": "create, no sha, path exists",
        "status": 422,
        "message": "Invalid request.\n\n\"sha\" wasn't supplied."
      },
      {
        "name": "update, well-formed but wrong sha",
        "status": 409,
        "message": "ledger/e000001-9c1f22aa.d7c41e0a95b2d4f1.log.enc does not match 6abd7d5cdfbf9c44a806872d2e0f200e39cf70c5",
        "messagePattern": "^<path> does not match <sha>$"
      },
      {
        "name": "update, malformed sha ('abc')",
        "status": 409,
        "message": "ledger/e000001-9c1f22aa.d7c41e0a95b2d4f1.log.enc does not match abc"
      },
      {
        "name": "update, current sha",
        "status": 200
      },
      {
        "name": "update, current sha, byte-identical content",
        "status": 200,
        "newCommit": true,
        "contentShaUnchanged": true,
        "treeUnchanged": true
      },
      {
        "name": "resend after the first landed (old sha, same content)",
        "status": 409,
        "message": "ledger/e000001-9c1f22aa.d7c41e0a95b2d4f1.log.enc does not match ec088b2227742ae88776d381ca0204523131ec67"
      },
      {
        "name": "create, path absent, a sha supplied anyway",
        "status": 201,
        "note": "the sha is ignored when the path does not exist"
      },
      {
        "name": "content base64 wrapped at 60 chars with \\n",
        "status": 201,
        "contentShaIsGitBlobSha": true
      },
      {
        "name": "content not valid base64",
        "status": 422,
        "message": "content is not valid Base64"
      }
    ],
    "errorBodyShape": {
      "keys": [
        "message",
        "documentation_url",
        "status"
      ],
      "statusFieldIsString": true
    }
  },
  "concurrency": {
