{
  "$comment": "Observed behaviour of the real GitHub REST API (api.github.com, X-GitHub-Api-Version 2022-11-28) for the calls GitHub sync uses. Recorded by probing a private throwaway repo with fictional content. docs/architecture/github-api-behaviour.md explains each fact and what the design does with it. fakeGitHub fidelity tests can assert against this file.",
  "probedAt": "2026-10-11",
  "target": {
    "repo": "Simba3696/ledger-sync-probe",
    "private": true,
    "defaultBranch": "main",
    "client": "gh 2.102.0 `gh api -i` (an OAuth user token with the repo scope; no fine-grained token was available)",
    "edgeRegion": "centralindia",
    "calls": {
      "github": 410,
      "unauthenticatedCurl": 15
    }
  },
  "emptyRepo": {
    "$comment": "A repo with no commits. Contents answers 404, every git/* endpoint answers 409.",
    "responses": [
      {
        "method": "GET",
        "path": "/repos/{o}/{r}/contents/",
        "status": 404,
        "message": "This repository is empty.",
        "documentation_url": "https://docs.github.com/v3/repos/contents/#get-contents",
        "statusField": "404"
      },
      {
        "method": "GET",
        "path": "/repos/{o}/{r}/contents/ledger",
        "status": 404,
