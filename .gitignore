node_modules/
dist/
# The whole scratch db/ folder (see README's Setup step 3) — not just its
# .backups/ subfolder — since it's real (if throwaway) financial data the
# moment anything's added through the app. A `git worktree`/second clone has
# no server/.env (gitignored, checkout-local) and falls back to this folder,
# so this also guards against accidentally committing real data that way.
db/
*.tmp-*
.env
.backups/
.claude/
# Local-only working notes and assistant config — kept on disk, never committed.
CLAUDE.md
docs/architecture/
docs/adr/
Ledger.bat
Ledger.ico
