node_modules/
dist/
# The whole scratch db/ folder (see README's Setup step 3) — not just its
# .backups/ subfolder — since it's real (if throwaway) financial data the
# moment anything's added through the app. A `git worktree`/second clone has
# no server/.env (gitignored, checkout-local) and falls back to this folder,
# so this also guards against accidentally committing real data that way.
# Anchored to the repo root (where workbookIO's default DB_DIR resolves) —
# an unanchored `db/` also matched source folders like server/src/db/.
/db/
*.tmp-*
.env
.backups/
# Shared project agents/skills are committed; everything else under .claude/
# (local settings, scheduled-task locks, worktrees) is machine-local.
.claude/*
!.claude/agents/
!.claude/skills/
# Supabase CLI local state (the project config and migrations are committed).
supabase/.branches/
supabase/.temp/
Ledger.bat
Ledger.ico
