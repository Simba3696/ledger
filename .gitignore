node_modules/
dist/
# The Excel edition's default data folder. Nothing here reads it any more,
# but an Excel-edition data folder copied into the repo to import
# (npm run import-xlsx) is real financial data, so it stays ignored.
# Anchored to the repo root — an unanchored `db/` also matched source
# folders like server/src/db/.
/db/
*.tmp-*
.env
.backups/
# Shared project agents/skills are committed; everything else under .claude/
# (local settings, scheduled-task locks, worktrees) is machine-local.
.claude/*
!.claude/agents/
!.claude/skills/
# Supabase CLI local state (the project config and migrations are committed).
supabase/.branches/
supabase/.temp/
Ledger.bat
Ledger.ico
