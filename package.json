{
  "name": "ledger",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "predev": "node scripts/kill-ports.js",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "stop": "node scripts/kill-ports.js",
    "test": "npm run test -w server",
    "test:client": "npm run test -w client",
    "test:e2e": "tsx e2e/regression.ts && tsx e2e/expensesOnly.ts",
    "screenshots": "tsx e2e/screenshots.ts",
    "import-xlsx": "tsx scripts/import-xlsx.ts",
    "build": "npm run build -w client && npm run build -w server",
    "prestart": "node scripts/kill-ports.js",
    "start": "npm run build && npm run start -w server",
    "lint": "npm run lint -w client && npm run lint -w server && npm run lint -w shared",
    "knip": "knip",
    "check:isolation": "node scripts/check-storage-isolation.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "knip": "^6.40.0",
    "playwright": "^1.61.1",
    "postgres": "^3.4.9",
    "tsx": "^4.23.1"
  },
  "dependencies": {
    "serverless-http": "^4.0.0"
  }
}
