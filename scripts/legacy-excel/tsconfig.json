{
  // Typecheck-only config so the importer's legacy Excel readers keep
  // compiling while nothing else imports them (LLD §8). Run with the server's
  // TypeScript: `cd server && npx tsc -p ../scripts/legacy-excel/tsconfig.json`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["*.ts"]
}
