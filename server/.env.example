# Copy this file to server/.env (gitignored, checkout-local) and uncomment
# whichever settings you need — an unset value keeps the default behavior.

# Overrides the default dev/prod port (4000). Only needed to run a second
# checkout (e.g. a git worktree on another branch) alongside this one
# without the two colliding — see README's "Running a second checkout
# alongside an existing one" section.
# PORT=4100

# Postgres connection string. For local development, the Supabase CLI's
# stack (`npx supabase start`); in production, the project's transaction
# pooler URL (port 6543). See docs/architecture/LLD.md §9.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# IANA timezone that decides what calendar day "today" is for due dates,
# renewals and reminders (ADR-0005). Defaults to Asia/Kolkata.
# APP_TIMEZONE=Asia/Kolkata

# API authentication (docs/architecture/LLD.md §6). Every /api request must
# carry a Supabase access token, verified against
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json, whose email is OWNER_EMAIL
# (case-insensitive). The server refuses to start without both unless
# AUTH_DISABLED=true. Local stack: SUPABASE_URL=http://127.0.0.1:54321.
# SUPABASE_URL=https://<project-ref>.supabase.co
# OWNER_EMAIL=owner@example.com

# Local development and tests only: skips the token check entirely. Only the
# exact value `true` counts. Refused at startup when NODE_ENV=production or
# when running on Netlify / AWS Lambda. Until the client has a sign-in
# screen, `npm run dev` and `npm run test:e2e` need it uncommented: the
# server won't start with neither this nor SUPABASE_URL + OWNER_EMAIL set.
# AUTH_DISABLED=true
