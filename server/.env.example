# Copy this file to server/.env (gitignored, checkout-local) and uncomment
# whichever settings you need — an unset value keeps the default behavior.

# Where the app's Excel-backed data lives. Leave unset to use the repo-local
# db/ scratch folder (see README's Setup section) while trying the app out;
# point this at your real spreadsheet folder once you're ready to use it for
# real. Forward slashes work here on every OS, including Windows.
# LEDGER_DB_DIR=C:/path/to/your/Expenses/folder

# Overrides the default dev/prod port (4000). Only needed to run a second
# checkout (e.g. a git worktree on another branch) alongside this one
# without the two colliding — see README's "Running a second checkout
# alongside an existing one" section.
# PORT=4100
