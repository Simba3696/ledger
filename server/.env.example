# Copy this file to server/.env (gitignored, checkout-local) for local
# development, and uncomment whichever settings you need. An unset value
# keeps the default behavior. On Netlify these are site environment
# variables instead (docs/DEPLOY.md step 7); nothing here is deployed.
# Every variable the server reads is listed here (docs/architecture/LLD.md §9).

# Overrides the local server's port (default 4000). Only needed to run a
# second checkout (e.g. a git worktree on another branch) alongside this one
# without the two colliding: see README's "Running a second checkout
# alongside an existing one". scripts/kill-ports.js reads it too. Not used
# on Netlify.
# PORT=4100

# Postgres connection string. Required. Local development: the Supabase
# CLI's stack (`npx supabase start`). Hosted: the project's Transaction
# pooler URI (port 6543) with the database password filled in, from the
# dashboard's Connect button (docs/DEPLOY.md step 6).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# IANA timezone that decides what calendar day "today" is for due dates,
# renewals and reminders (ADR-0005). Defaults to Asia/Kolkata. An invalid
# name makes requests that need "today" fail with a 500.
# APP_TIMEZONE=Asia/Kolkata

# API authentication (docs/architecture/LLD.md §6). Every /api request must
# carry a Supabase access token, verified against
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json, whose email is OWNER_EMAIL
# (case-insensitive). The server refuses to start without both unless
# AUTH_DISABLED=true. Local stack: SUPABASE_URL=http://127.0.0.1:54321 and
# OWNER_EMAIL=owner@example.test, the owner account supabase/seed.sql
# creates (password `local-owner-password`, local stack only).
# SUPABASE_URL=https://<project-ref>.supabase.co
# OWNER_EMAIL=owner@example.com

# Which sections this deployment serves (ADR-0006, LLD §5.1): a
# comma-separated list of expenses, finances, debts, emi, credit-cards and
# subscriptions (case-insensitive). Unset or blank enables all of them. An
# unknown name stops the server at startup. The Dashboard is always on. To
# add a section later, change this and redeploy; no migration is needed.
# ENABLED_MODULES=expenses

# Local development and tests only: skips the token check entirely. Only the
# exact value `true` counts. Refused at startup when NODE_ENV=production or
# when running on Netlify / AWS Lambda. Not needed for `npm run dev` or
# `npm run test:e2e` (e2e refuses it): point SUPABASE_URL at the local stack
# and set OWNER_EMAIL as above.
# AUTH_DISABLED=true

# Read but never set by hand: NODE_ENV (=production makes AUTH_DISABLED
# refused), and NETLIFY, AWS_LAMBDA_FUNCTION_NAME and LAMBDA_TASK_ROOT, which
# the hosting platform sets and which mark the process as deployed (the
# AUTH_DISABLED refusal, and no stack traces in error pages).
